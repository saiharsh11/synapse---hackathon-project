# Copy this file to .env and fill in real values. Never commit .env.

# Meta Model API (https://dev.meta.ai) — base URL https://api.meta.ai/v1
MODEL_API_KEY=your-meta-model-api-key

# Baseten — base URL https://inference.baseten.co/v1, model meta-models/muse-spark-open-1026
BASETEN_API_KEY=your-baseten-api-key

# Modal (sandboxes) — from https://modal.com/settings/tokens
MODAL_TOKEN_ID=your-modal-token-id
MODAL_TOKEN_SECRET=your-modal-token-secret

# Fireworks (stretch goal)
FIREWORKS_API_KEY=your-fireworks-api-key
